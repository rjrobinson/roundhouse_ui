<% content_for :title, "Retries" %>

<%= render "roundhouse_ui/shared/search_bar", action: retries_path,
      noun: "class, jid, error or arguments" %>

<%= render "roundhouse_ui/shared/filter_error" %>
<%= render "roundhouse_ui/shared/tag_filter" %>

<%= set_heading("Retries", showing: @jobs.size, total: @total, query: @query, tag: @tag) %>

<% if any_filter?(@query, @tag) %>
  <div class="rh-actionbar">
    <div class="rh-actiongroup">
      <span class="rh-actionlabel" title="<%= filter_description(@query, @tag) %>">
        All <%= number_with_delimiter @total %> <%= filter_description(@query, @tag) %>
      </span>
      <%= link_to "↻ Run now", preview_bulk_retries_path(**filter_params(op: "retry")), class: "rh-btn" %>
      <%= link_to "✕ Delete", preview_bulk_retries_path(**filter_params(op: "delete")), class: "rh-btn rh-btn-danger" %>
    </div>
  </div>
<% end %>

<%= trace_legend(@jobs) %>
<table class="rh-table">
  <thead><tr><th>Job</th><% if tag_column? %><th><%= tag_column_label %></th><% end %><th>Queue</th><th>Last error</th><th>Attempt</th><th>Next try</th><th class="r">Actions</th></tr></thead>
  <tbody>
    <% if @jobs.empty? %>
      <tr><td colspan="<%= tag_column? ? 7 : 6 %>" class="rh-empty"><%= empty_state(@query, @tag, noun: "retries", all_clear: "Nothing waiting to retry 🎉") %></td></tr>
    <% else %>
      <% @jobs.each do |job| %>
        <tr>
          <td><%= job_identity(job_display_class(job), job.jid, job_path(set: "retry", jid: job.jid)) %></td>
          <% if tag_column? %><td><%= tag_cell(tags_for(job)) %></td><% end %>
          <td><%= queue_pill(job.queue, link: true) %></td>
          <td>
            <span class="rh-err"><%= job.item["error_class"] %></span>
            <% if job.item["error_message"].present? %><br><span class="rh-sub" title="<%= job.item["error_message"] %>"><%= truncate(job.item["error_message"], length: 90) %></span><% end %>
          </td>
          <td><%= attempt_ladder(job.item["retry_count"].to_i + 1) %></td>
          <%# `since` is the last failure, so the ring shows how far through the
              backoff this job is, not only when it next fires. %>
          <td><span class="rh-next"><%= countdown(job.at, since: job.item["failed_at"] && Time.at(job.item["failed_at"])) %></span></td>
          <td class="r rh-cell-actions">
            <%= find_like_link("retry", job) %>
              <%= trace_icon(klass: job_display_class(job), jid: job.jid, queue: job.queue) %>
            <% if job_editing? %><%= link_to "Edit", edit_job_path(set: "retry", jid: job.jid), class: "rh-btn" %><% end %>
            <%= button_to "Run now", run_retry_path(job.jid), method: :post, class: "rh-btn", form_class: "rh-inline" %>
            <%= button_to "Delete", delete_retry_path(job.jid), method: :post, class: "rh-btn rh-btn-danger", form_class: "rh-inline", data: { turbo_confirm: "Delete #{job.jid}?" } %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<%= render "roundhouse_ui/shared/pager" %>
