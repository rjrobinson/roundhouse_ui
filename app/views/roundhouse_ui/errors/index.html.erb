<% content_for :title, "Errors" %>

<%= render "roundhouse_ui/shared/search_bar", action: errors_path,
      keys: RoundhouseUi::ErrorsController::FILTER_KEYS,
      noun: "class, error or squad" %>
<%= render "roundhouse_ui/shared/filter_error" %>

<%# Counts come from the same scan that built the groups, so this costs no extra
    Redis work. Each chip narrows the list below rather than sending you elsewhere. %>
<%= render "roundhouse_ui/shared/tag_filter", counts: @tag_counts %>

<h2 class="rh-h2">
  Errors · <%= pluralize(@groups.size, "issue") %>
  <% if @tag %><span class="hint">filtered to <%= @tag[0] %>: <%= @tag[1] %></span><% end %>
</h2>

<%= trace_legend(@groups) %>
<table class="rh-table">
  <thead>
    <tr>
      <th>Issue</th>
      <% if tag_column? %><th><%= tag_column_label %></th><% end %>
      <th class="r">Occurrences</th>
      <th>In</th>
      <th>Queues</th>
      <th class="r">Last seen</th>
    </tr>
  </thead>
  <tbody>
    <% if @groups.empty? %>
      <tr><td colspan="<%= tag_column? ? 6 : 5 %>" class="rh-empty">
        <%= empty_state(@query, @tag, noun: "issues", all_clear: "No failing jobs 🎉") %>
      </td></tr>
    <% else %>
      <%# Occurrences carry magnitude as well as a figure: 340 and 2 should not
          look the same when you are scanning for the one that matters. Severity
          is by share of the total, since "a lot" is relative to the page. %>
      <% worst = @groups.map { |x| x[:count].to_i }.max || 0 %>
      <% @groups.each do |g| %>
        <% share = worst.positive? ? g[:count].to_f / worst : 0 %>
        <tr data-rh-sev="<%= share >= 0.5 ? "crit" : share >= 0.15 ? "warn" : "ok" %>">
          <td><%= g[:klass] %> <%= error_trace_icon(klass: g[:klass], error: g[:error]) %>
            <%# The grouped rows are where someone lands during an incident, so the
                runbook belongs here as much as on the individual job. %>
            <%= runbook_link(g[:klass], label: "runbook") %>
            <br><span class="rh-err"><%= g[:error] %></span></td>
          <% if tag_column? %><td><%= tag_cell(@group_tags[g[:klass]]) %></td><% end %>
          <td class="r">
            <span class="rh-count" data-rh-sev="<%= share >= 0.5 ? "crit" : share >= 0.15 ? "warn" : "ok" %>"
                  title="<%= number_with_delimiter g[:count] %><%= "+" if @truncated %> of <%= number_with_delimiter worst %><%= "+" if @truncated %> in the worst group<%= " — counts are floors, the scan stopped at #{number_with_delimiter @scan_limit}" if @truncated %>">
              <i style="width:<%= (share * 100).round(1) %>%"></i>
              <%# A truncated scan yields floors, not totals: the group holds at least
                  this many. Printing an exact figure for a number we know is capped
                  is the one thing the note below the table cannot fix. %>
              <span><%= number_with_delimiter g[:count] %><%= "+" if @truncated %></span>
            </span>
          </td>
          <td><span class="rh-sub"><%= g[:sources].join(", ") %></span></td>
          <td><%= safe_join(g[:queues].map { |q| queue_pill(q) }, " ") %></td>
          <td class="r"><%= job_time(g[:last_at], overdue: "#{time_ago_in_words(g[:last_at])} ago" ) if g[:last_at] %><%= content_tag(:span, "—", class: "rh-sub") unless g[:last_at] %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<% if @truncated %>
  <p class="rh-note">Grouped the most recent <%= number_with_delimiter @scan_limit %> failures — older entries not yet scanned.</p>
<% end %>
