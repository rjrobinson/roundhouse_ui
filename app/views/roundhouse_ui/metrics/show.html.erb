<% content_for :title, "Metrics" %>

<h2 class="rh-h2">Capacity &amp; reliability <span class="hint">live snapshot</span></h2>
<div class="rh-cards">
  <div class="rh-card">
    <div class="k">Utilization</div>
    <div class="v num" style="<%= "color:var(--warn)" if @metrics.utilization && @metrics.utilization >= 0.9 %>"><%= @metrics.utilization ? "#{(@metrics.utilization * 100).round}%" : "—" %></div>
    <div class="d"><span class="num"><%= @metrics.busy %></span> / <%= @metrics.concurrency %> threads</div>
  </div>
  <div class="rh-card">
    <div class="k">Idle headroom</div>
    <div class="v num"><%= @metrics.headroom %></div>
    <div class="d">worker threads free</div>
  </div>
  <div class="rh-card">
    <div class="k">Backlog</div>
    <div class="v num"><%= number_with_delimiter @metrics.backlog %></div>
    <div class="d">enqueued + scheduled + retry</div>
  </div>
  <div class="rh-card">
    <div class="k">Failure ratio</div>
    <div class="v num"><%= (@metrics.failure_ratio * 100).round(2) %>%</div>
    <div class="d">failed / processed · lifetime</div>
  </div>
</div>

<h2 class="rh-h2">Live rates <span class="hint">computed client-side · last few seconds</span></h2>
<div class="rh-cards">
  <div class="rh-card">
    <div class="k">Throughput</div>
    <div class="v num" id="rh-m-throughput">—</div>
    <div class="d">jobs / sec · completed</div>
  </div>
  <div class="rh-card">
    <div class="k">Failure rate</div>
    <div class="v num" id="rh-m-failrate">—</div>
    <div class="d">share of recent jobs</div>
  </div>
  <div class="rh-card">
    <div class="k">Backlog velocity</div>
    <div class="v num" id="rh-m-velocity">—</div>
    <div class="d">+ growing · − draining</div>
  </div>
  <div class="rh-card">
    <div class="k">Burn-down ETA</div>
    <div class="v num" id="rh-m-eta">—</div>
    <div class="d">backlog clears in, at current rate</div>
  </div>
  <%# Capacity is deliberately whole-fleet rather than per queue: Sidekiq counts
      processed jobs globally, so there is no honest way to say what share of
      throughput belongs to one queue. See #36. %>
  <div class="rh-card">
    <div class="k">Capacity
      <select id="rh-m-deadline" class="rh-btn rh-cap-pick" aria-label="Clear the backlog within">
        <option value="900">15m</option>
        <option value="3600" selected>1h</option>
        <option value="14400">4h</option>
      </select>
    </div>
    <div class="v num" id="rh-m-capacity">—</div>
    <div class="d" id="rh-m-capacity-note">threads needed to clear in time</div>
  </div>
</div>

<% if RoundhouseUi.collect_durations %>
  <h2 class="rh-h2">Slowest job classes <span class="hint">by total time · from RoundhouseUi::DurationCollector</span></h2>
  <% if @durations.blank? %>
    <div class="rh-panel"><div class="rh-empty">No durations recorded yet — jobs need to run with the collector middleware installed.</div></div>
  <% else %>
    <table class="rh-table">
      <thead><tr><th>Job class</th><th class="r">Runs</th><th class="r">Avg</th><th>Total time</th></tr></thead>
      <tbody>
        <%# The point of "slowest classes" is proportion — this one class is most
            of your compute — and proportion is a length, not a figure you compare
            by reading down a column. %>
        <% worst = @durations.map { |d| d[:total_ms].to_f }.max || 0 %>
        <% @durations.each do |d| %>
          <tr>
            <td class="rh-mono"><%= d[:klass] %></td>
            <td class="r rh-mono"><%= number_with_delimiter d[:count] %></td>
            <td class="r rh-mono <%= "rh-lat-warn" if d[:avg_ms] >= 1000 %>"><%= duration_ms(d[:avg_ms]) %></td>
            <td>
              <div class="rh-dbar">
                <div class="t"><i style="width:<%= worst.positive? ? (d[:total_ms].to_f / worst * 100).round(1) : 0 %>%"></i></div>
                <span class="n"><%= duration_ms(d[:total_ms]) %></span>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
