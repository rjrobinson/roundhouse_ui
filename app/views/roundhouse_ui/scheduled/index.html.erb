<% content_for :title, "Scheduled" %>

<form method="get" action="<%= scheduled_path %>" class="rh-search">
  <input type="search" name="q" value="<%= @query %>" placeholder="search class, jid, or arg value…">
  <% if params[:tag].present? %><input type="hidden" name="tag" value="<%= params[:tag] %>"><% end %>
  <% if params[:queue].present? %><input type="hidden" name="queue" value="<%= params[:queue] %>"><% end %>
</form>

<%= render "roundhouse_ui/shared/tag_filter" %>

<%= set_heading("Scheduled", showing: @jobs.size, total: @total, query: @query, tag: @tag) %>
<%= trace_legend(@jobs) %>
<table class="rh-table">
  <thead><tr><th>Job</th><% if tag_column? %><th><%= tag_column_label %></th><% end %><th>Queue</th><th class="r">Runs</th><th class="r">Actions</th></tr></thead>
  <tbody>
    <% if @jobs.empty? %>
      <tr><td colspan="<%= tag_column? ? 5 : 4 %>" class="rh-empty"><%= any_filter?(@query, @tag) ? "No scheduled jobs #{filter_description(@query, @tag)}." : "Nothing scheduled" %></td></tr>
    <% else %>
      <% @jobs.each do |job| %>
        <tr>
          <td><%= job_identity(job_display_class(job), job.jid, job_path(set: "scheduled", jid: job.jid)) %></td>
          <% if tag_column? %><td><%= tag_cell(tags_for(job)) %></td><% end %>
          <td><%= queue_pill(job.queue, link: true) %></td>
          <td class="r"><%= job_time(job.at) %></td>
          <td class="r rh-cell-actions">
            <%= find_like_link("scheduled", job) %>
              <%= trace_icon(klass: job_display_class(job), jid: job.jid, queue: job.queue) %>
            <% if RoundhouseUi.allow_job_editing %><%= link_to "Edit", edit_job_path(set: "scheduled", jid: job.jid), class: "rh-btn" %><% end %>
            <%= button_to "Enqueue now", enqueue_scheduled_path(job.jid), method: :post, class: "rh-btn", form_class: "rh-inline" %>
            <%= button_to "Delete", delete_scheduled_path(job.jid), method: :post, class: "rh-btn rh-btn-danger", form_class: "rh-inline", data: { turbo_confirm: "Delete #{job.jid}?" } %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<%= render "roundhouse_ui/shared/pager" %>
