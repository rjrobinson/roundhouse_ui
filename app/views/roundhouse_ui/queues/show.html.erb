<% content_for :title, "Queue #{@name}" %>

<form method="get" action="<%= queue_path(@name) %>" class="rh-search">
  <input type="search" name="q" value="<%= @query %>" placeholder="search class, jid, or arg value…">
  <% if params[:tag].present? %><input type="hidden" name="tag" value="<%= params[:tag] %>"><% end %>
</form>

<%= render "roundhouse_ui/shared/tag_filter" %>

<h2 class="rh-h2">
  <%= queue_pill(@name) %>
  <span class="hint">
    <%= number_with_delimiter @total %> waiting
    <% if @latency %>· oldest <%= duration(@latency) %><% end %>
    <% if @paused %>· <span class="rh-pill rh-pill-warn">paused</span><% end %>
  </span>
  <span class="rh-spacer"></span>
  <%= link_to "← All queues", queues_path, class: "rh-btn" %>
</h2>

<table class="rh-table">
  <thead>
    <tr>
      <th>Job</th>
      <% if tag_column? %><th><%= tag_column_label %></th><% end %>
      <th>Arguments</th>
      <th class="r">Enqueued</th>
    </tr>
  </thead>
  <tbody>
    <% if @jobs.empty? %>
      <tr><td colspan="<%= tag_column? ? 4 : 3 %>" class="rh-empty">
        <%= any_filter?(@query, @tag) ? "Nothing on “#{@name}” #{filter_description(@query, @tag)}." : "Nothing waiting on “#{@name}”." %>
      </td></tr>
    <% else %>
      <% @jobs.each do |job| %>
        <tr>
          <td>
            <%= job_display_class(job) %>
            <div class="rh-sub rh-mono rh-jid" title="<%= job.jid %>"><%= job.jid %></div>
          </td>
          <% if tag_column? %><td><%= tag_cell(tags_for(job)) %></td><% end %>
          <td><%= job_args_preview(job) %></td>
          <td class="r"><%= job_time(RoundhouseUi.enqueued_at(job.item), overdue: "just now") %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<%= render "roundhouse_ui/shared/pager" %>

<p class="rh-note">
  Jobs waiting to be picked up, oldest last. Queue-level actions live on the
  <%= link_to "queues list", queues_path %>.
</p>
