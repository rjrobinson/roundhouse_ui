<% content_for :title, "Queues" %>

<form method="get" action="<%= queues_path %>" class="rh-search">
  <input type="search" name="q" value="<%= @query %>" placeholder="filter queues by name…">
</form>

<% if RoundhouseUi.allow_job_editing %>
  <div class="rh-toolbar"><%= link_to "+ Enqueue job", new_job_path, class: "rh-btn rh-btn-primary" %></div>
<% end %>

<% if RoundhouseUi.pause_enabled && !@fetch_installed %>
  <div class="rh-warn">
    Pausing is <strong>recorded but not enforced</strong> — no Roundhouse fetcher has reported in.
    Add it to your Sidekiq config: <code>config[:fetch_class] = RoundhouseUi::Fetch</code>
  </div>
<% end %>

<%# State chips. A paused queue is the single most common thing an operator is
    hunting for on this page — it is why work is not moving. Hidden where pausing
    is turned off: filtering by a state you cannot set is a dead end. %>
<% if RoundhouseUi.pause_enabled %>
<div class="rh-quickfilters">
  <%= link_to queues_path(q: @query.presence), class: "rh-qf#{' is-on' if @state.blank?}" do %>
    All <span class="rh-qf-n"><%= @state_counts.values.sum %></span>
  <% end %>
  <%= link_to queues_path(q: @query.presence, state: "active"), class: "rh-qf#{' is-on' if @state == 'active'}" do %>
    Active <span class="rh-qf-n"><%= @state_counts["active"] %></span>
  <% end %>
  <%= link_to queues_path(q: @query.presence, state: "paused"), class: "rh-qf#{' is-on' if @state == 'paused'}" do %>
    Paused <span class="rh-qf-n"><%= @state_counts["paused"] %></span>
  <% end %>
</div>
<% end %>

<h2 class="rh-h2">Queues · <%= number_with_delimiter @total_size %> waiting<% if @query.present? %> <span class="hint">filtered to “<%= @query %>”</span><% end %><% if @state.present? %> <span class="hint"><%= @state %> only</span><% end %></h2>
<table class="rh-table">
  <thead><tr>
    <th class="rh-sort" data-sort-col="0" data-sort-type="text">Queue</th>
    <th class="rh-sort" data-sort-col="1" data-sort-type="text">State</th>
    <th class="rh-sort r" data-sort-col="2" data-sort-type="num">Size</th>
    <th class="rh-sort r" data-sort-col="3" data-sort-type="num">Latency</th>
    <th class="rh-trend-h">Trend</th>
    <th class="rh-sort" data-sort-col="5" data-sort-type="num">Forecast</th>
    <th class="r">Actions</th>
  </tr></thead>
  <tbody>
    <% if @queues.empty? %>
      <tr><td colspan="7" class="rh-empty"><%= @query.present? ? "No queues match “#{@query}”." : "No active queues" %></td></tr>
    <% else %>
      <% @queues.each do |q| %>
        <% paused = @paused.include?(q.name) %>
        <% latency = q.latency %>
        <%# data-rh-sev is set by the poll once a velocity exists; the server seeds
            what it can already know so the stripe is not blank on first paint. %>
        <tr data-rh-sev="<%= q.size.zero? ? "ok" : (latency > 600 ? "crit" : latency > 60 ? "warn" : "ok") %>">
          <td data-sort-value="<%= q.name %>"><%= link_to queue_pill(q.name), queue_path(q.name), class: "rh-pill-link" %></td>
          <td data-sort-value="<%= paused ? "paused" : "active" %>"><% if paused %><span class="rh-pill rh-pill-warn">paused</span><% else %><span class="rh-sub">active</span><% end %></td>
          <td class="r" data-sort-value="<%= q.size %>"><%= number_with_delimiter q.size %></td>
          <td class="r <%= "rh-lat-warn" if latency > 60 %>" data-sort-value="<%= latency.to_f %>"><%= duration(latency) %></td>
          <%# Filled by the stats poll — it needs two samples for a velocity, so
              the first paint honestly says it is still measuring. %>
          <%# Both render; the poll reveals the canvas once it has two samples to
              draw. Shown the other way round the canvas would be a blank gap. %>
          <td class="rh-trend">
            <span class="rh-trend-empty" data-rh-spark-wait="<%= q.name %>"></span>
            <canvas width="176" height="44" data-rh-spark="<%= q.name %>" aria-hidden="true" hidden></canvas>
          </td>
          <%# sort-value starts unknown and is written by the poll, so an unmeasured
              queue sorts last rather than pretending to be zero. %>
          <td data-sort-value=""><span class="rh-fc rh-fc-wait" data-rh-forecast="<%= q.name %>"><%= q.size.zero? ? "clear" : "measuring…" %></span></td>
          <td class="r">
            <% if RoundhouseUi.pause_enabled %>
              <% if paused %>
                <%= button_to "Resume", resume_queue_path(q.name), method: :post, class: "rh-btn", form_class: "rh-inline" %>
              <% else %>
                <%= button_to "Pause", pause_queue_path(q.name), method: :post, class: "rh-btn", form_class: "rh-inline" %>
              <% end %>
            <% end %>
            <%= button_to "Snapshot", snapshot_queue_path(q.name), method: :post, class: "rh-btn", form_class: "rh-inline" %>
            <%= button_to "Purge", purge_queue_path(q.name),
                  method: :post,
                  class: "rh-btn rh-btn-danger",
                  form_class: "rh-inline",
                  data: { turbo_confirm: "Purge “#{q.name}”? This permanently deletes #{number_with_delimiter q.size} jobs. Snapshot first if you might need them back." } %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
