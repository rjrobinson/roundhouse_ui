<% content_for :title, "Confirm bulk #{@op}" %>

<h2 class="rh-h2">
  <%= @op == "delete" ? "Delete" : "Retry" %>
  <%= number_with_delimiter @matched.entries.size %>
  <%= @noun.pluralize(@matched.entries.size) %>?
  <span class="hint"><%= filter_description(@query, @tag) %></span>
</h2>

<% if @matched.entries.empty? %>
  <div class="rh-panel">
    <p class="rh-empty">Nothing matches <%= filter_description(@query, @tag) %>. Nothing to do.</p>
  </div>
  <p><%= link_to "← Back", @back_path, class: "rh-btn" %></p>
<% else %>
  <% if @matched.capped %>
    <div class="rh-warn">
      Stopped at the <%= RoundhouseUi::JobSetBrowsing::BULK_CAP %>-job cap. More jobs match than
      are listed here — this action will touch the <%= number_with_delimiter @matched.entries.size %>
      below, and you can run it again for the rest.
    </div>
  <% end %>

  <div class="rh-toolbar">
    <%= button_to "#{@op == "delete" ? "✕ Delete" : "↻ Retry"} #{number_with_delimiter @matched.entries.size} #{@noun.pluralize(@matched.entries.size)}",
          @confirm_path,
          method: :post,
          params: { op: @op, q: @query, tag: params[:tag], queue: params[:queue] },
          class: "rh-btn #{'rh-btn-danger' if @op == 'delete'}",
          form_class: "rh-inline" %>
    <%= link_to "Cancel", @back_path, class: "rh-btn" %>
  </div>

  <table class="rh-table">
    <thead>
      <tr>
        <th>Job</th>
        <% if tag_column? %><th><%= tag_column_label %></th><% end %>
        <th>Queue</th>
        <th>Arguments</th>
        <th>Last error</th>
      </tr>
    </thead>
    <tbody>
      <%# Only the first 100 are listed; the count above is what will be touched. %>
      <% @matched.entries.first(100).each do |entry| %>
        <tr>
          <td><%= job_identity(job_display_class(entry), entry.jid, job_path(set: @set, jid: entry.jid)) %></td>
          <% if tag_column? %><td><%= tag_cell(tags_for(entry)) %></td><% end %>
          <td><%= queue_pill(entry.queue) %></td>
          <td><%= job_args_preview(entry) %></td>
          <td><span class="rh-err"><%= entry.item["error_class"] %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @matched.entries.size > 100 %>
    <p class="rh-note">
      Showing the first 100 of <%= number_with_delimiter @matched.entries.size %>.
      All <%= number_with_delimiter @matched.entries.size %> will be
      <%= @op == "delete" ? "deleted" : "retried" %>.
    </p>
  <% end %>
<% end %>
