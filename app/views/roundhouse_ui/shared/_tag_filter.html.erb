<%# Tag filter chips (ADR 0002 step 4), shared by the job sets and Errors.
    Errors passes `counts` because grouping already scanned every entry; the job
    sets don't, since browse deliberately reads only enough to fill one page and
    counting would turn a 25-row render into a full-set scan. %>
<%# .presence matters: an empty counts hash is truthy, so treating it as "we have
    counts" while falling back to the uncounted vocabulary made the two branches
    disagree and blew up sorting a Hash-of-Arrays as if it were Hash-of-counts. %>
<% counts = local_assigns[:counts].presence %>
<% if RoundhouseUi.job_tags %>
  <% vocabulary = counts || tag_vocabulary %>
  <% if vocabulary.present? %>
    <div class="rh-quickfilters">
      <% vocabulary.each do |key, values| %>
        <% values = values.sort_by { |_, count| -count } if counts %>
        <% values.each do |value, count| %>
          <% active = @tag == [ key.to_s, value.to_s ] %>
          <%= link_to filter_url(page: nil, tag: (active ? nil : "#{key}:#{value}")),
                class: "rh-qf#{' is-on' if active}", title: "#{key}: #{value}" do %>
            <%= value %><% if count %><span class="rh-qf-n"><%= number_with_delimiter count %></span><% end %>
          <% end %>
        <% end %>
      <% end %>
      <% if @tag %>
        <%= link_to "clear", filter_url(tag: nil, page: nil), class: "rh-sub" %>
      <% end %>
    </div>
  <% end %>
<% end %>
