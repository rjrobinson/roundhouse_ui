<!DOCTYPE html>
<html>
<head>
  <title>Roundhouse</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>
  <style nonce="<%= content_nonce %>">
    :root {
      --bg:#0B0E14; --panel:#10141D; --panel-2:#151A24; --panel-3:#1A2030;
      --line:#1E2533; --line-soft:#171C26; --text:#EAEDF3; --muted:#939DAF; --faint:#5A6475;
      --accent:#6E8BFF; --accent-2:#9B8CFC; --good:#44C58C; --warn:#E2A53F; --crit:#E66A60;
      --mono:ui-monospace,"SF Mono","JetBrains Mono",Menlo,monospace;
      --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    }
    :root[data-theme="light"]{
      --bg:#F5F6F9; --panel:#FFFFFF; --panel-2:#EEF1F6; --panel-3:#E6EAF2;
      --line:#DCE1EA; --line-soft:#E7EBF1; --text:#1A1F2B; --muted:#5C6677; --faint:#97A0B1;
      --accent:#4F68E8; --accent-2:#7E6CF0; --good:#1FA46B; --warn:#B97D17; --crit:#D24A40;
    }
    /* dark bg on <html> kills the white flash between full-page navigations */
    html { background:#0B0E14; color-scheme:dark; }
    :root[data-theme="light"], html:has(:root[data-theme="light"]) { color-scheme:light; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font:14px/1.5 var(--sans); -webkit-font-smoothing:antialiased; }
    .num { font-family:var(--mono); font-variant-numeric:tabular-nums; }
    a { color:inherit; }

    .rh-app { display:grid; grid-template-columns:236px 1fr; min-height:100vh; }
    .rh-rail { background:#090C11; border-right:1px solid var(--line-soft); padding:20px 14px; display:flex; flex-direction:column; gap:22px; position:sticky; top:0; height:100vh; overflow-y:auto; }
    :root[data-theme="light"] .rh-rail { background:#FBFCFE; }
    .rh-brand { display:flex; align-items:center; gap:11px; padding:2px 6px; }
    .rh-brand .glyph { width:30px; height:30px; border-radius:8px; background:linear-gradient(140deg,var(--accent),var(--accent-2)); display:grid; place-items:center; color:#0B0E14; font-size:16px; font-weight:800; }
    .rh-brand b { font-size:15px; letter-spacing:-.01em; display:block; }
    .rh-brand small { font-size:11px; color:var(--faint); }
    .rh-grp { display:flex; flex-direction:column; gap:2px; }
    .rh-grp-label { font-size:10px; letter-spacing:.13em; text-transform:uppercase; color:var(--faint); padding:0 8px 6px; font-weight:600; }
    .rh-nav { display:flex; align-items:center; gap:11px; padding:7px 10px; border-radius:9px; color:var(--muted); text-decoration:none; border:1px solid transparent; }
    .rh-nav:hover { background:var(--panel); color:var(--text); }
    .rh-nav.is-active { background:var(--panel-2); color:var(--text); border-color:var(--line); }
    .rh-nav .rh-ico { width:18px; text-align:center; font-size:14px; opacity:.85; }
    .rh-nav .rh-lbl { flex:1; }
    .rh-badge { font-family:var(--mono); font-variant-numeric:tabular-nums; font-size:11px; padding:1px 7px; border-radius:999px; background:var(--panel-2); color:var(--muted); min-width:8px; text-align:center; }
    .rh-badge:empty { display:none; }
    .rh-badge.warn { background:rgba(226,165,63,.16); color:var(--warn); }
    .rh-badge.crit { background:rgba(230,106,96,.16); color:var(--crit); }

    .rh-main { padding:22px 30px 70px; max-width:1180px; }
    :root[data-width="full"] .rh-main { max-width:none; }
    .rh-iconbtn.is-on { color:var(--text); border-color:var(--accent); }
    .rh-top { display:flex; align-items:center; gap:14px; margin-bottom:22px; }
    .rh-top h1 { font-size:21px; font-weight:650; letter-spacing:-.02em; margin:0; }
    .rh-crumb { color:var(--faint); font-size:13px; }
    .rh-spacer { flex:1; }
    .rh-live { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--muted); }
    .rh-dot { width:7px; height:7px; border-radius:50%; background:var(--good); position:relative; }
    .rh-dot::after { content:""; position:absolute; inset:0; border-radius:50%; background:var(--good); animation:rh-ping 2.4s ease-out infinite; }
    @keyframes rh-ping { 0%{transform:scale(1);opacity:.7} 70%{transform:scale(3.4);opacity:0} 100%{opacity:0} }
    @media (prefers-reduced-motion:reduce){ .rh-dot::after{animation:none} }
    .rh-iconbtn { width:34px; height:34px; border-radius:9px; cursor:pointer; background:var(--panel); border:1px solid var(--line); color:var(--muted); font-size:15px; }
    .rh-iconbtn:hover { color:var(--text); border-color:var(--accent); }
    .rh-ro { font-size:11px; padding:3px 9px; border-radius:7px; background:rgba(226,165,63,.16); color:var(--warn); font-weight:600; }

    .rh-flash { padding:10px 14px; font-size:13px; border-radius:10px; margin-bottom:16px; }
    .rh-flash-ok { background:rgba(68,197,140,.12); color:var(--good); border:1px solid rgba(68,197,140,.3); }
    .rh-flash-bad { background:rgba(226,165,63,.12); color:var(--warn); border:1px solid rgba(226,165,63,.35); }

    .rh-h2 { font-size:13px; font-weight:600; margin:0 0 12px; display:flex; align-items:baseline; gap:10px; }
    .rh-h2 .hint { font-size:12px; color:var(--faint); font-weight:400; }
    .rh-panel { background:var(--panel); border:1px solid var(--line-soft); border-radius:12px; overflow:hidden; }

    table.rh-table { width:100%; border-collapse:collapse; background:var(--panel); border:1px solid var(--line-soft); border-radius:12px; overflow:hidden; }
    .rh-table th { text-align:left; font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--faint); font-weight:600; padding:11px 16px; border-bottom:1px solid var(--line-soft); }
    .rh-table th.r, .rh-table td.r { text-align:right; }
    .rh-table td { padding:12px 16px; border-bottom:1px solid var(--line-soft); }
    .rh-table tr:last-child td { border-bottom:none; }
    .rh-mono { font-family:var(--mono); font-variant-numeric:tabular-nums; }
    .rh-sub { color:var(--faint); font-size:12px; }
    .rh-err { color:var(--crit); font-family:var(--mono); font-size:12px; }
    .rh-empty { color:var(--faint); text-align:center; padding:30px 16px; }
    .rh-trace { color:var(--accent); text-decoration:none; font-size:11px; }
    .rh-trace:hover { text-decoration:underline; }

    .rh-st { display:inline-flex; align-items:center; font-size:11px; font-weight:600; padding:2px 9px; border-radius:6px; }
    .rh-st-ok { background:rgba(68,197,140,.14); color:var(--good); }
    .rh-st-warn { background:rgba(226,165,63,.16); color:var(--warn); }
    .rh-st-crit { background:rgba(230,106,96,.16); color:var(--crit); }
    .rh-st-paused { background:var(--panel-3); color:var(--muted); }
    .rh-pill { font-size:11px; padding:2px 8px; border-radius:999px; font-family:var(--mono); background:var(--panel-2); color:var(--muted); }
    .rh-pill-warn { background:rgba(226,165,63,.16); color:var(--warn); }
    .rh-pill-tag { background:var(--panel-2); color:var(--text); border:1px solid var(--line); max-width:22ch; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:middle; }
    /* jid sits inline after the class now; dim it so it reads as a copy target
       rather than competing with the job name. Still fully selectable. */
    /* --muted, not --faint: the jid is secondary but still has to be readable
       at a glance when you're comparing it against a log line. */
    .rh-jid { color:var(--muted); opacity:1; font-size:11.5px; letter-spacing:.02em; margin-top:3px; }

    /* Bulk actions. Two scopes — ticked rows vs every match — kept visually
       separate, because confusing them destroys the wrong jobs. */
    .rh-actionbar { display:flex; flex-wrap:wrap; align-items:stretch; gap:10px; margin-bottom:14px; }
    .rh-actiongroup { display:flex; align-items:center; gap:7px; padding:7px 12px; border:1px solid var(--line-soft);
                      border-radius:11px; background:var(--panel); }
    .rh-actionlabel { font-size:11px; letter-spacing:.05em; text-transform:uppercase; color:var(--faint);
                      font-weight:600; margin-right:3px; max-width:34ch; overflow:hidden; text-overflow:ellipsis;
                      white-space:nowrap; }
    .rh-actiongroup form { display:inline; margin:0; }
    /* Icon-only observability link for table rows. Sized like a button so it
       sits on the Actions baseline without stretching the row. */
    .rh-trace-ico { display:inline-block; width:24px; text-align:center; padding:5px 0; border-radius:7px;
                    border:1px solid transparent; text-decoration:none; }
    .rh-trace-ico:hover { border-color:var(--accent); background:var(--panel-2); }
    .rh-pill-link { text-decoration:none; border:1px solid transparent; }
    .rh-pill-link:hover { border-color:var(--accent); color:var(--text); }
    .rh-pill-link.is-on { border-color:var(--accent); color:var(--text); background:var(--panel-3); }

    /* Quick filters: counts by tag, from the scan that already ran. */
    /* Motion. Every effect here is meant to carry information rather than
       decorate: a value that changed, a queue that will not drain, time until
       the next refresh. All of it is dropped for prefers-reduced-motion. */
    .rh-ico { display:inline-grid; place-items:center; width:16px; height:16px; flex:0 0 16px; }
    .rh-ico svg { display:block; }

    /* A polled number that actually changed. The only effect on this page that
       tells you something you could not otherwise see. */
    @keyframes rh-flash { from { background:color-mix(in srgb, var(--accent) 32%, transparent); } to { background:transparent; } }
    .rh-changed { animation:rh-flash 1.4s ease-out; border-radius:4px; }

    /* Rows settle in on navigation. Not on poll — the poll never re-renders a
       table, so this fires once per page rather than every few seconds. */
    @keyframes rh-rowin { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } }
    .rh-table tbody tr { animation:rh-rowin .3s cubic-bezier(.2,.7,.3,1) backwards; }
    .rh-table tbody tr:nth-child(2) { animation-delay:.04s; }
    .rh-table tbody tr:nth-child(3) { animation-delay:.08s; }
    .rh-table tbody tr:nth-child(4) { animation-delay:.12s; }
    .rh-table tbody tr:nth-child(n+5) { animation-delay:.16s; }

    /* The one row that will not fix itself. Slow on purpose — faster reads as an
       alarm, and an alarm you see all day is one you stop seeing. */
    @keyframes rh-pulse { 0%, 100% { opacity:1; } 50% { opacity:.58; } }
    .rh-fc-growing { animation:rh-pulse 2.6s ease-in-out infinite; }

    .rh-btn, .rh-iconbtn { transition:transform .09s ease, border-color .12s ease, background .12s ease; }
    .rh-btn:active, .rh-iconbtn:active { transform:scale(.95); }

    @keyframes rh-toastin { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
    .rh-flash { animation:rh-toastin .3s cubic-bezier(.2,.8,.3,1); }

    .rh-nav { transition:background .16s ease, color .16s ease, border-color .16s ease; }

    @media (prefers-reduced-motion: reduce) {
      .rh-table tbody tr, .rh-fc-growing, .rh-flash, .rh-changed { animation:none !important; }
      .rh-btn, .rh-iconbtn, .rh-nav { transition:none !important; }
      .rh-btn:active, .rh-iconbtn:active { transform:none; }
    }

    /* Drain forecast (#35). "Growing" is the state that matters during an
       incident, so it is the only one that gets a colour that demands attention. */
    .rh-sort { cursor:pointer; user-select:none; white-space:nowrap; }
    .rh-sort:hover { color:var(--muted); }
    .rh-sort::after { content:"↕"; opacity:.28; margin-left:5px; font-size:10px; }
    .rh-sort.is-asc::after  { content:"↑"; opacity:1; color:var(--accent); }
    .rh-sort.is-desc::after { content:"↓"; opacity:1; color:var(--accent); }

    .rh-runbook { font-size:11px; font-family:var(--mono); color:var(--accent); text-decoration:none;
                  border:1px solid var(--line); border-radius:6px; padding:1px 7px; white-space:nowrap; }
    .rh-runbook:hover { border-color:var(--accent); background:var(--panel-2); }

    .rh-cap-pick { font-size:10px; padding:1px 5px; margin-left:6px; vertical-align:middle; }

    .rh-fc { font-size:12px; font-family:var(--mono); white-space:nowrap; }
    .rh-fc-wait { color:var(--faint); }
    .rh-fc-draining { color:var(--good); }
    .rh-fc-stalled { color:var(--warn); }
    .rh-fc-growing { color:var(--crit); font-weight:600; }

    .rh-settings { padding:4px 0; }
    .rh-setting { display:flex; align-items:center; gap:24px; padding:16px 18px; border-bottom:1px solid var(--line-soft); }
    .rh-setting:last-child { border-bottom:none; }
    .rh-setting-label { flex:1; display:flex; flex-direction:column; gap:3px; }
    .rh-setting-label b { font-size:13px; font-weight:600; }
    .rh-setting-control { flex:0 0 auto; }
    .rh-setting-control select { min-width:190px; }

    .rh-quickfilters { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:14px; }
    .rh-qf { display:inline-flex; align-items:center; gap:7px; font-size:12px; text-decoration:none;
             background:var(--panel); border:1px solid var(--line); border-radius:999px; padding:4px 10px; color:var(--muted); }
    .rh-qf:hover { border-color:var(--accent); color:var(--text); }
    .rh-qf.is-on { border-color:var(--accent); color:var(--text); background:var(--panel-2); }
    .rh-qf-n { font-family:var(--mono); font-variant-numeric:tabular-nums; font-size:11px; color:var(--faint); }
    .rh-qf.is-on .rh-qf-n { color:var(--accent); }

    .rh-btn { font:inherit; font-size:12px; background:var(--panel-2); color:var(--text); border:1px solid var(--line); padding:5px 11px; border-radius:7px; cursor:pointer; text-decoration:none; display:inline-block; }
    .rh-btn:hover { border-color:var(--accent); }
    .rh-btn-danger:hover { border-color:var(--crit); color:var(--crit); }
    .rh-inline { display:inline; margin:0; }

    .rh-search { margin-bottom:16px; }
    .rh-search input { width:100%; background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:10px 14px; color:var(--text); font:13px var(--mono); }
    .rh-search input:focus { outline:none; border-color:var(--accent); }
    .rh-bulkbar { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
    .rh-note { color:var(--faint); font-size:12px; margin-top:14px; }
    .rh-warn { background:rgba(226,165,63,.12); border:1px solid rgba(226,165,63,.4); color:var(--warn); border-radius:10px; padding:11px 14px; margin-bottom:18px; font-size:13px; }
    .rh-warn code { background:rgba(0,0,0,.25); padding:1px 6px; border-radius:5px; font-size:12px; }
    .rh-lat-warn { color:var(--warn); }

    /* dashboard */
    .rh-alerts { display:flex; flex-direction:column; gap:8px; margin-bottom:22px; }
    .rh-alert { display:flex; align-items:center; gap:12px; background:var(--panel); border:1px solid var(--line-soft); border-left:3px solid var(--crit); border-radius:10px; padding:11px 14px; font-size:13px; }
    .rh-alert.warn { border-left-color:var(--warn); }
    .rh-alert .msg { flex:1; } .rh-alert .msg b { font-family:var(--mono); }
    .rh-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:16px; }
    .rh-card { background:var(--panel); border:1px solid var(--line-soft); border-radius:12px; padding:16px 17px; }
    .rh-card .k { font-size:12px; color:var(--muted); margin-bottom:9px; }
    .rh-card .v { font-family:var(--mono); font-variant-numeric:tabular-nums; font-size:26px; letter-spacing:-.02em; line-height:1; }
    .rh-card .v small { font-size:14px; color:var(--faint); }
    .rh-card .d { font-size:12px; margin-top:8px; color:var(--faint); }
    .rh-card .d.up { color:var(--good); } .rh-card .d.bad { color:var(--crit); }
    .rh-card .pill { display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:600; padding:4px 10px; border-radius:7px; margin-bottom:9px; background:rgba(226,165,63,.14); color:var(--warn); }
    .rh-card .pill.ok { background:rgba(68,197,140,.14); color:var(--good); }
    .rh-chart-wrap { background:var(--panel); border:1px solid var(--line-soft); border-radius:12px; padding:18px 20px 10px; margin-bottom:24px; position:relative; }
    #rh-chart-tip { position:absolute; top:34px; transform:translateX(-50%); pointer-events:none; background:var(--panel-3); border:1px solid var(--line); color:var(--text); font:11px var(--mono); padding:2px 7px; border-radius:6px; white-space:nowrap; }
    #rh-chart-tip[hidden] { display:none; }
    .rh-chart-wrap .top { display:flex; align-items:baseline; gap:12px; margin-bottom:6px; }
    .rh-chart-wrap h3 { font-size:13px; font-weight:600; margin:0; }
    .rh-chart-wrap .now { margin-left:auto; font-family:var(--mono); font-size:13px; color:var(--accent); }
    canvas#rh-chart { display:block; width:100%; height:90px; }
    .rh-cb { width:15px; height:15px; }

    /* composite health banner */
    .rh-health { background:var(--panel); border:1px solid var(--line-soft); border-left:3px solid var(--faint); border-radius:12px; margin-bottom:18px; }
    .rh-health-ok { border-left-color:var(--good); }
    .rh-health-warn { border-left-color:var(--warn); }
    .rh-health-crit { border-left-color:var(--crit); }
    .rh-health summary { display:flex; align-items:center; gap:12px; padding:14px 16px; cursor:pointer; list-style:none; }
    .rh-health summary::-webkit-details-marker { display:none; }
    .rh-health-dot { width:9px; height:9px; border-radius:50%; flex:none; background:var(--faint); }
    .rh-health-ok .rh-health-dot { background:var(--good); }
    .rh-health-warn .rh-health-dot { background:var(--warn); }
    .rh-health-crit .rh-health-dot { background:var(--crit); }
    .rh-health-verdict { font-weight:650; font-size:15px; }
    .rh-health-ok .rh-health-verdict { color:var(--good); }
    .rh-health-warn .rh-health-verdict { color:var(--warn); }
    .rh-health-crit .rh-health-verdict { color:var(--crit); }
    .rh-health-reason { color:var(--muted); font-size:13px; }
    .rh-health-cta { margin-left:auto; font:11px var(--mono); color:var(--faint); }
    .rh-health[open] .rh-health-cta { color:var(--accent); }
    .rh-health-signals { padding:2px 16px 14px; display:flex; flex-direction:column; gap:8px; border-top:1px solid var(--line-soft); margin-top:2px; padding-top:12px; }
    .rh-sig { display:flex; align-items:center; gap:10px; font-size:13px; }
    .rh-sig b { min-width:170px; font-weight:600; }

    /* insight panels */
    .rh-insights { display:grid; gap:14px; margin-bottom:24px; }
    @media(min-width:760px){ .rh-insights { grid-template-columns:1fr 1fr; } }
    .rh-insight { padding:6px 0; }
    .rh-insight-h { display:flex; align-items:baseline; justify-content:space-between; gap:10px; font-size:13px; font-weight:600; padding:13px 16px 10px; }
    .rh-insight-row { display:flex; align-items:center; gap:12px; padding:10px 16px; border-top:1px solid var(--line-soft); }
    .rh-insight-row .rh-insight-main { flex:1; min-width:0; font-size:13px; }
    .rh-insight-row .rh-pill { font-variant-numeric:tabular-nums; }
    .rh-insight .rh-empty { padding:18px 16px; }

    /* collapsible disclosure (large args, full backtrace) */
    .rh-disclose summary { cursor:pointer; font:12px var(--mono); color:var(--accent); padding:6px 0; list-style:none; }
    .rh-disclose summary::-webkit-details-marker { display:none; }
    .rh-disclose summary::before { content:"▸ "; }
    .rh-disclose[open] summary::before { content:"▾ "; }

    /* Time until the next refresh. The numbers on every page are a few seconds
       old at best, and with the interval configurable (2–300s) there was no way
       to tell a fresh number from a stale one. A depleting arc reads as time
       remaining rather than progress toward something. */
    .rh-tick { position:relative; width:12px; height:12px; border-radius:50%; flex:0 0 auto;
               background:var(--panel-2); display:inline-block; }
    .rh-tick-fill { position:absolute; inset:0; border-radius:50%;
                    background:conic-gradient(var(--good) var(--rh-tick-turn, 1turn), transparent 0);
                    transition:none; }
    /* The arc is driven by one linear transition per poll rather than a rAF loop
       or an animation whose duration has to be kept in sync with the timer. */
    .rh-tick-fill.is-running { transition:--rh-tick-turn linear; }
    .rh-live.is-stale .rh-tick { background:var(--crit); }
    .rh-live.is-stale .rh-tick-fill { background:none; }
    @property --rh-tick-turn { syntax: "<angle>"; inherits: false; initial-value: 1turn; }
    /* No smoothly sweeping arc for anyone who asked for less motion — it snaps
       full on each refresh instead, which still says "just updated". */
    @media (prefers-reduced-motion: reduce) {
      .rh-tick-fill, .rh-tick-fill.is-running { transition:none !important; }
    }

    /* connection state — poll failures surface here instead of silently going stale */
    .rh-live.is-stale .rh-dot { background:var(--crit); }
    .rh-live.is-stale .rh-dot::after { animation:none; }

    /* keyboard focus — visible on every interactive control */
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible,
    summary:focus-visible, .rh-nav:focus-visible { outline:2px solid var(--accent); outline-offset:2px; border-radius:6px; }

    /* on-call / mobile: stack the rail on top as a horizontal nav, collapse the grid */
    @media (max-width:760px) {
      .rh-app { grid-template-columns:1fr; }
      .rh-rail { position:static; height:auto; flex-direction:row; flex-wrap:wrap; gap:6px 14px; align-items:center; border-right:none; border-bottom:1px solid var(--line-soft); }
      .rh-rail .rh-grp { flex-direction:row; flex-wrap:wrap; gap:4px; }
      .rh-rail .rh-grp-label { display:none; }
      .rh-brand { width:100%; }
      .rh-main { padding:16px 16px 60px; }
      .rh-cards { grid-template-columns:1fr 1fr; }
      .rh-top { flex-wrap:wrap; }
    }
    @media (max-width:440px) { .rh-cards { grid-template-columns:1fr; } }
    .rh-field { margin-bottom:16px; max-width:640px; }
    .rh-field label { display:block; font-size:12px; color:var(--muted); margin-bottom:6px; }
    .rh-field input, .rh-field textarea { width:100%; background:var(--panel); border:1px solid var(--line); border-radius:9px; padding:9px 12px; color:var(--text); font:13px var(--mono); }
    .rh-field input:focus, .rh-field textarea:focus { outline:none; border-color:var(--accent); }
    .rh-btn-primary { background:var(--accent); border-color:var(--accent); color:#fff; }
    .rh-btn-primary:hover { filter:brightness(1.08); border-color:var(--accent); }
    .rh-toolbar { display:flex; justify-content:flex-end; margin-bottom:12px; }
    .rh-pager { display:flex; align-items:center; gap:14px; margin-top:16px; }
    .rh-pre { font:12px/1.6 var(--mono); color:var(--muted); background:var(--bg); border:1px solid var(--line-soft); border-radius:10px; padding:12px 14px; overflow-x:auto; white-space:pre; }
    .rh-tags { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; }
    .rh-tag { font-size:12px; padding:3px 9px; border-radius:6px; background:var(--panel-2); color:var(--muted); }
    .rh-sec { font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--faint); font-weight:600; margin:22px 0 8px; }
    .rh-joblink { color:inherit; text-decoration:none; }
    .rh-joblink:hover { text-decoration:underline; }
    .rh-kbd { font:11px var(--mono); color:var(--faint); background:var(--panel); border:1px solid var(--line); border-radius:7px; padding:6px 9px; cursor:pointer; }
    .rh-kbd:hover { color:var(--text); border-color:var(--accent); }
    .rh-palette[hidden] { display:none; }
    .rh-palette { position:fixed; inset:0; background:rgba(5,7,11,.55); z-index:80; display:flex; align-items:flex-start; justify-content:center; padding-top:14vh; backdrop-filter:blur(2px); }
    .rh-palette-box { width:560px; max-width:92vw; background:var(--panel); border:1px solid var(--line); border-radius:14px; box-shadow:0 18px 55px rgba(0,0,0,.55); overflow:hidden; }
    .rh-palette-box input { width:100%; background:none; border:none; border-bottom:1px solid var(--line-soft); padding:15px 18px; color:var(--text); font:15px var(--sans); outline:none; }
    .rh-palette-list { max-height:340px; overflow-y:auto; padding:6px; }
    .rh-palette-item { display:flex; align-items:center; gap:12px; padding:9px 12px; border-radius:9px; cursor:pointer; font-size:13px; }
    .rh-palette-item.sel { background:var(--panel-2); }
    .rh-palette-ico { width:20px; text-align:center; color:var(--muted); }
    <%# Host colour overrides, emitted last so they win without !important. Only
        known tokens, values shape-checked — see lib/roundhouse_ui/theme.rb %>
    <%= RoundhouseUi::Theme.css&.html_safe %>
    <%= RoundhouseUi::Theme.selectable_css&.html_safe %>
  </style>
  <%# Apply the saved theme before first paint so it persists across navigations with no flash. %>
  <script nonce="<%= content_nonce %>">
    (function () { try { var t = localStorage.getItem("rh-theme"); if (t) document.documentElement.setAttribute("data-theme", t); var w = localStorage.getItem("rh-width"); if (w) document.documentElement.setAttribute("data-width", w); var p = localStorage.getItem("rh-palette"); if (p) document.documentElement.setAttribute("data-rh-palette", p); } catch (e) {} })();
  </script>
  <%# Turbo Drive: link navigation without full-page reloads (kills the flicker). %>
  <script src="<%= turbo_js_path %>"></script>
  <script nonce="<%= content_nonce %>">
    (function () {
      var fmt = function (n) { return Number(n).toLocaleString(); };
      var started = false, lastProcessed = null, lastFailed = null, lastBacklog = null, lastT = null;
      var HOST_POLL_MS = <%= (RoundhouseUi.poll_interval.to_f * 1000).round %>;
      function storedPollMs() {
        try {
          var v = parseFloat(localStorage.getItem("rh-poll"));
          // Clamped: this comes from the browser, and 0 would hammer the mount.
          if (!isNaN(v) && v > 0) return Math.min(Math.max(v, 2), 300) * 1000;
        } catch (_) {}
        return HOST_POLL_MS;
      }
      var POLL_MS = storedPollMs();
      var samples = [], buckets = [], bucketStart = null; // samples = current bucket; buckets = finalized per-interval averages
      var lastPts = []; // points last drawn, for the hover tooltip to read
      function setText(id, t) { var el = document.getElementById(id); if (el) el.textContent = t; }
      // Drain forecast (#35). The question during a backlog is not "how long if
      // arrivals stopped" — it is "will this clear at all", and that needs *net*
      // velocity, not throughput. Three answers, because a signed number is the
      // whole point: draining, stalled, or growing.
      //
      // Depth is an integer and dt is a few seconds, so a single sample's
      // velocity is quantised and noisy — one unlucky poll would flip the label.
      // Smoothed with an EWMA so the label reflects a trend rather than a tick.
      var lastDepths = null, smoothVel = {}, lastCapacity = null;
      var STALLED_PER_MIN = 1; // below one job a minute either way, nothing is happening

      function smooth(key, v) {
        var prev = smoothVel[key];
        return (smoothVel[key] = prev == null ? v : (prev * 0.7) + (v * 0.3));
      }

      // vel is jobs/second, signed: negative drains, positive grows.
      function forecast(depth, vel) {
        if (depth === 0) return { text: "clear", cls: "" };
        if (vel == null) return { text: "measuring…", cls: "rh-fc-wait" };
        if (Math.abs(vel) * 60 < STALLED_PER_MIN) return { text: "stalled", cls: "rh-fc-stalled" };
        if (vel > 0) return { text: "growing " + rateLabel(vel) + " — will not drain", cls: "rh-fc-growing" };
        return { text: "clears in " + humanizeEta(depth / -vel), cls: "rh-fc-draining" };
      }

      // One urgency scale for the Forecast column, low = healthy, so an ascending
      // sort reads best-first like every other column. Bands are kept far apart
      // rather than blended, because "draining in 3 days" and "growing slowly"
      // are different kinds of problem and should not interleave.
      //
      //   clear      -1
      //   draining   seconds to clear   (sooner is better)
      //   stalled    1e12
      //   growing    1e13 + jobs/sec    (faster is worse)
      //
      // An unmeasured queue returns "", which the sorter puts last in both
      // directions — see sortRows.
      function forecastSort(depth, vel) {
        if (depth === 0) return -1;
        if (vel == null) return "";
        if (Math.abs(vel) * 60 < STALLED_PER_MIN) return 1e12;
        return vel > 0 ? 1e13 + vel : depth / -vel;
      }

      function rateLabel(vel) {
        var v = Math.abs(vel);
        return v >= 1 ? v.toFixed(0) + "/s" : Math.round(v * 60) + "/min";
      }

      function paintForecast(el, depth, vel) {
        var f = forecast(depth, vel);
        el.textContent = f.text;
        el.className = "rh-fc " + f.cls;
      }

      function humanizeEta(s) {
        if (s < 60) return "~" + Math.round(s) + "s";
        if (s < 3600) return "~" + Math.round(s / 60) + "m";
        if (s < 86400) return "~" + (s / 3600).toFixed(1) + "h";
        return "~" + (s / 86400).toFixed(1) + "d";
      }

      // Bucket interval in seconds, from the picker — a new chart point lands
      // once per interval, so "per 1m" advances every minute (not every poll).
      function chartInterval() { var s = document.getElementById("rh-chart-interval"); return s ? parseInt(s.value, 10) : 30; }
      function avg(a) { return a.length ? a.reduce(function (s, v) { return s + v; }, 0) / a.length : 0; }
      function draw() {
        var cv = document.getElementById("rh-chart"); if (!cv) return;
        var ctx = cv.getContext("2d"), w = cv.width, h = cv.height, pad = 6;
        ctx.clearRect(0, 0, w, h);
        // finalized buckets + the in-progress bucket as a provisional last point,
        // so the chart shows data immediately instead of waiting a full interval.
        var pts = buckets.slice(-60); if (samples.length) pts = pts.concat([ avg(samples) ]);
        lastPts = pts;
        var n = pts.length; if (n < 2) { setText("rh-chart-peak", ""); return; }
        var peak = Math.max.apply(null, pts);
        var max = peak * 1.25 || 1;
        var x = function (i) { return i / (n - 1) * w; }, y = function (v) { return h - pad - v / max * (h - pad * 2); };
        var g = ctx.createLinearGradient(0, 0, 0, h); g.addColorStop(0, "rgba(110,139,255,.30)"); g.addColorStop(1, "rgba(110,139,255,0)");
        ctx.beginPath(); ctx.moveTo(0, h); pts.forEach(function (v, i) { ctx.lineTo(x(i), y(v)); }); ctx.lineTo(w, h); ctx.closePath(); ctx.fillStyle = g; ctx.fill();
        ctx.beginPath(); pts.forEach(function (v, i) { i ? ctx.lineTo(x(i), y(v)) : ctx.moveTo(x(i), y(v)); }); ctx.strokeStyle = "#6E8BFF"; ctx.lineWidth = 2; ctx.lineJoin = "round"; ctx.stroke();
        // emphasized endpoint (small marker; canvas is vertically scaled, so a rect reads cleaner than an arc)
        ctx.fillStyle = "#6E8BFF"; ctx.fillRect(x(n - 1) - 3, y(pts[n - 1]) - 3, 6, 6);
        setText("rh-chart-peak", "peak " + Math.round(peak) + "/s");
      }
      // Hover tooltip: map the cursor's fractional x to the nearest drawn point.
      function chartHover(e) {
        var cv = document.getElementById("rh-chart"), tip = document.getElementById("rh-chart-tip");
        if (!cv || !tip || lastPts.length < 2) return;
        var rect = cv.getBoundingClientRect();
        var fx = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
        var idx = Math.round(fx * (lastPts.length - 1));
        tip.textContent = Math.round(lastPts[idx]) + "/s";
        tip.style.left = (e.clientX - rect.left) + "px";
        tip.hidden = false;
      }
      function setValue(el, text) {
        if (el.textContent === text) return; // unchanged: no flash, or the page blinks constantly
        el.textContent = text;
        el.classList.remove("rh-changed");
        void el.offsetWidth;
        el.classList.add("rh-changed");
      }
      function apply(d) {
        Object.keys(d).forEach(function (k) {
          var text = fmt(d[k]);
          document.querySelectorAll('[data-stat="' + k + '"]').forEach(function (el) { setValue(el, text); });
          document.querySelectorAll('[data-nav="' + k + '"]').forEach(function (el) { setValue(el, text); });
        });
      }
      function poll() {
        if (document.hidden) return;
        fetch("<%= dashboard_stats_path %>", { headers: { Accept: "application/json" } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            setConn(true);
            restartTick();
            apply(d);
            // Feeds the ⌘K palette. Derived from the depth keys rather than sent
            // twice — see the stats endpoint.
            if (d.queue_depths) QUEUE_NAMES = Object.keys(d.queue_depths).sort();
            var now = Date.now();
            var backlog = d.enqueued + d.scheduled + d.retries;
            if (lastProcessed != null) {
              var dt = (now - lastT) / 1000;
              var dp = d.processed - lastProcessed;
              var rate = dt > 0 ? Math.max(0, dp / dt) : 0;
              var re = document.querySelector('[data-stat="rate"]'); if (re) re.textContent = fmt(Math.round(rate * 60));
              var ne = document.getElementById("rh-chart-now"); if (ne) ne.textContent = Math.round(rate);
              // Accumulate into the current bucket; finalize it (one averaged point)
              // once the chosen interval has elapsed. Live "/s" still updates each poll.
              samples.push(rate);
              if (bucketStart == null) bucketStart = now;
              if ((now - bucketStart) / 1000 >= chartInterval()) {
                buckets.push(avg(samples)); if (buckets.length > 240) buckets.shift();
                samples = []; bucketStart = now;
              }
              draw();

              // Metrics tab live rates (these elements exist only on that page).
              setText("rh-m-throughput", Math.round(rate) + "/s");
              var fr = dp > 0 ? Math.max(0, (d.failed - lastFailed) / dp) : 0;
              setText("rh-m-failrate", (fr * 100).toFixed(1) + "%");
              if (lastBacklog != null && dt > 0) {
                var vel = (backlog - lastBacklog) / dt;
                setText("rh-m-velocity", (vel >= 0 ? "+" : "") + vel.toFixed(1) + "/s");
              }
              // Was backlog/throughput, which answers "how long if nothing else
              // arrives" — a number that stays reassuring while the backlog grows.
              var netVel = lastBacklog != null && dt > 0 ? smooth("__total", (backlog - lastBacklog) / dt) : null;
              setText("rh-m-eta", forecast(backlog, netVel).text);

              var pick = document.getElementById("rh-m-deadline");
              if (pick) {
                var c = capacity(backlog, rate, netVel, d.concurrency, parseInt(pick.value, 10));
                setText("rh-m-capacity", c.text);
                setText("rh-m-capacity-note", c.note);
                // Remember the last inputs so changing the deadline answers
                // immediately rather than waiting for the next poll.
                lastCapacity = { backlog: backlog, rate: rate, vel: netVel, concurrency: d.concurrency };
              }
            }
            // Per-queue forecast. Rendered wherever a cell asks for one, so the
            // Queues table, a queue page and the dashboard all read the same
            // number rather than three approximations of it.
            if (d.queue_depths) {
              var dtq = lastT ? (now - lastT) / 1000 : 0;
              document.querySelectorAll("[data-rh-forecast]").forEach(function (el) {
                var name = el.getAttribute("data-rh-forecast");
                var depth = d.queue_depths[name];
                if (depth == null) return;
                var vel = null;
                if (lastDepths && lastDepths[name] != null && dtq > 0) {
                  vel = smooth(name, (depth - lastDepths[name]) / dtq);
                }
                paintForecast(el, depth, vel);
                var cell = el.closest("td");
                if (cell) cell.setAttribute("data-sort-value", forecastSort(depth, vel));
              });
              // Drop state for queues that no longer exist. A queue that goes
              // away and comes back must start measuring afresh, or its old
              // smoothed velocity is blended into the first new sample.
              Object.keys(smoothVel).forEach(function (k) {
                if (k !== "__total" && !(k in d.queue_depths)) delete smoothVel[k];
              });
              lastDepths = d.queue_depths;
            }
            lastProcessed = d.processed; lastFailed = d.failed; lastBacklog = backlog; lastT = now;
          })
          .catch(function () { setConn(false); });
      }
      // Restart the countdown arc. One transition per poll, so there is no rAF
      // loop and nothing to keep in sync with the timer — and because it is
      // driven off the same POLL_MS the timer uses, changing the interval in
      // Settings is reflected immediately rather than on the next page load.
      function restartTick() {
        var el = document.getElementById("rh-tick");
        if (!el) return;
        el.classList.remove("is-running");
        el.style.transitionDuration = "0s";
        el.style.setProperty("--rh-tick-turn", "1turn");
        void el.offsetWidth; // flush, or the reset coalesces with the sweep below
        el.classList.add("is-running");
        el.style.transitionDuration = POLL_MS + "ms";
        el.style.setProperty("--rh-tick-turn", "0turn");
      }

      // Capacity (#36). The forecast says whether a backlog clears; this says what
      // to do about it. Whole-fleet only — Sidekiq counts processed jobs
      // globally, so claiming a per-queue thread count would be inventing the
      // split.
      //
      //   arrivals   = throughput + net velocity   (what is coming in)
      //   need       = backlog / deadline + arrivals   (rate to clear in time)
      //   perThread  = throughput / concurrency
      //
      // Arrivals are included on purpose: sizing to backlog alone under-provisions
      // exactly when it matters, because work keeps arriving while you drain.
      function capacity(backlog, rate, vel, concurrency, deadlineSecs) {
        if (!concurrency) return { text: "—", note: "no workers reporting in" };
        if (backlog === 0) return { text: "0", note: "nothing waiting" };
        if (!rate) return { text: "—", note: "no throughput to measure from" };

        var perThread = rate / concurrency;
        var arrivals = Math.max(0, rate + (vel || 0));
        var need = Math.ceil((backlog / deadlineSecs + arrivals) / perThread);
        var extra = need - concurrency;
        if (extra <= 0) {
          return { text: concurrency + " ✓", note: "current fleet clears it in time" };
        }
        return { text: "+" + extra,
                 note: "on top of " + concurrency + " — " + need + " threads to clear in time" };
      }

      // Sortable tables (#queues). Client-side on purpose: the Forecast column
      // has no server-side value at all — it is computed from two polls — so a
      // server sort could not order by it. Doing all columns the same way keeps
      // one behaviour rather than two.
      //
      // Comparison reads data-sort-value, never the cell text: latency renders
      // as "3h 19m" and the forecast as a sentence, and parsing those back would
      // be re-deriving what the server already knew.
      function sortRows(table, col, dir) {
        var tbody = table.tBodies[0];
        if (!tbody) return;
        var rows = Array.prototype.slice.call(tbody.rows).filter(function (r) {
          return !r.querySelector(".rh-empty");
        });
        var type = table.tHead.rows[0].cells[col].getAttribute("data-sort-type");
        rows.sort(function (a, b) {
          var x = cellValue(a, col), y = cellValue(b, col);
          // Rows with no value yet ("measuring…") sort last in both directions
          // rather than clustering at whichever end zero happens to fall.
          if (x === "" && y === "") return 0;
          if (x === "") return 1;
          if (y === "") return -1;
          var cmp = type === "num" ? parseFloat(x) - parseFloat(y) : String(x).localeCompare(String(y));
          return dir === "asc" ? cmp : -cmp;
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
      }

      function cellValue(row, col) {
        var cell = row.cells[col];
        if (!cell) return "";
        var v = cell.getAttribute("data-sort-value");
        return v == null ? cell.textContent.trim() : v;
      }

      document.addEventListener("click", function (e) {
        var th = e.target.closest && e.target.closest("th.rh-sort");
        if (!th) return;
        var table = th.closest("table");
        var wasAsc = th.classList.contains("is-asc");
        table.querySelectorAll("th.rh-sort").forEach(function (o) {
          o.classList.remove("is-asc", "is-desc");
        });
        // Numbers open descending: on this page the interesting end of Size and
        // Latency is the big one, which is the same reason the default order is
        // worst-first.
        var dir = wasAsc ? "desc" : (th.classList.contains("is-desc") ? "asc"
                                     : (th.getAttribute("data-sort-type") === "num" ? "desc" : "asc"));
        th.classList.add(dir === "asc" ? "is-asc" : "is-desc");
        sortRows(table, parseInt(th.getAttribute("data-sort-col"), 10), dir);
      });

      // Surface a failed poll instead of letting the numbers silently go stale.
      function setConn(ok) {
        var el = document.getElementById("rh-live"), lbl = document.getElementById("rh-live-label");
        if (el) el.classList.toggle("is-stale", !ok);
        if (lbl) lbl.textContent = ok ? "live" : "reconnecting…";
      }
      // The timer handle is kept so a viewer changing the refresh interval in
      // Settings takes effect immediately, rather than on the next full page load.
      var pollHandle = null;
      function startOnce() { if (started) return; started = true; poll(); restartPoll(); }
      function restartPoll() {
        if (pollHandle) clearInterval(pollHandle);
        POLL_MS = storedPollMs();
        pollHandle = setInterval(poll, POLL_MS);
        restartTick();
      }
      function wireChart() {
        var cv = document.getElementById("rh-chart"); if (!cv) return;
        cv.onmousemove = chartHover;
        cv.onmouseleave = function () { var t = document.getElementById("rh-chart-tip"); if (t) t.hidden = true; };
      }
      function syncTheme() { var b = document.getElementById("rh-theme"); if (b) b.textContent = document.documentElement.getAttribute("data-theme") === "light" ? "☀" : "☾"; }
      function syncWidth() { var b = document.getElementById("rh-width"); if (b) b.classList.toggle("is-on", document.documentElement.getAttribute("data-width") === "full"); }

      // The sidebar is turbo-permanent (so its badges don't flicker), so we move
      // the active-nav highlight ourselves on each navigation.
      var ROOT = "<%= root_path %>".replace(/\/$/, "");
      function setActiveNav() {
        var path = location.pathname.replace(/\/$/, "");
        document.querySelectorAll("#rh-rail .rh-nav").forEach(function (a) {
          var href = (a.getAttribute("href") || "").replace(/\/$/, "");
          var active = href === path || (href && href !== ROOT && path.indexOf(href) === 0);
          a.classList.toggle("is-active", !!active);
        });
      }

      // theme toggle via delegation so it survives Turbo body swaps
      document.addEventListener("click", function (e) {
        var b = e.target.closest && e.target.closest("#rh-theme"); if (!b) return;
        var next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("rh-theme", next); } catch (_) {}
        syncTheme(); syncSettingsForm();
      });
      // width toggle (compact 1180px ⟷ full) — same persistence pattern as theme
      document.addEventListener("click", function (e) {
        var b = e.target.closest && e.target.closest("#rh-width"); if (!b) return;
        var next = document.documentElement.getAttribute("data-width") === "full" ? "compact" : "full";
        document.documentElement.setAttribute("data-width", next);
        try { localStorage.setItem("rh-width", next); } catch (_) {}
        syncWidth(); syncSettingsForm();
      });
      // command palette (⌘K). Two halves: static navigation, and search actions
      // built from whatever you type — paste a JID, a queue, or a squad and the
      // palette offers the searches that will actually find it, rather than
      // making you pick a page first and search again once you're there.
      // Capability-gated exactly like the sidebar: a backend without a retry
      // set must not be offered a search into one.
      var SETS = [
        { label: "Dead",      path: "<%= dead_set_path %>",  icon: "<%= RoundhouseUi::Icons.markup(:dead) %>" },
        <% if RoundhouseUi.backend.supports?(:retries) %>{ label: "Retries", path: "<%= retries_path %>", icon: "<%= RoundhouseUi::Icons.markup(:retries) %>" },<% end %>
        { label: "Scheduled", path: "<%= scheduled_path %>", icon: "<%= RoundhouseUi::Icons.markup(:scheduled) %>" },
        { label: "Errors",    path: "<%= errors_path %>",    icon: "<%= RoundhouseUi::Icons.markup(:errors) %>" }
      ];
      // Declared tag vocabulary and live queue names, so the palette can tell a
      // squad from a queue from a free-text term.
      var TAG_VOCAB = <%== (RoundhouseUi::Tags.filters || {}).to_json %>;
      // Filled by the stats poll, which already loads queues for its count, so
      // knowing the queue names costs no extra Redis work.
      var QUEUE_NAMES = [];

      function palQuery(q) {
        var out = [], seen = {};
        // A 12+ char hex string is a Sidekiq JID — offer the sets directly.
        if (/^[0-9a-f]{12,}$/i.test(q)) {
          SETS.forEach(function (s) {
            out.push({ label: "Find job " + q + " in " + s.label, icon: s.icon,
                       path: s.path + "?q=" + encodeURIComponent(q) });
          });
          return out;
        }
        // Exact squad / tag value → the structured filter, which is stricter
        // and safer than a substring match.
        Object.keys(TAG_VOCAB).forEach(function (key) {
          TAG_VOCAB[key].forEach(function (value) {
            if (value.toLowerCase().indexOf(q) !== 0) return;
            seen[value] = true;
            SETS.forEach(function (s) {
              out.push({ label: key + ": " + value + " — " + s.label, icon: "<%= RoundhouseUi::Icons.markup(:dashboard) %>",
                         path: s.path + "?tag=" + encodeURIComponent(key + ":" + value) });
            });
          });
        });
        // Known queue name → filter by queue.
        QUEUE_NAMES.forEach(function (name) {
          if (name.toLowerCase().indexOf(q) !== 0) return;
          SETS.slice(0, 3).forEach(function (s) {
            out.push({ label: "Queue " + name + " — " + s.label, icon: "<%= RoundhouseUi::Icons.markup(:queues) %>",
                       path: s.path + "?queue=" + encodeURIComponent(name) });
          });
        });
        // Always offer plain text search as a fallback.
        SETS.forEach(function (s) {
          out.push({ label: "Search " + s.label + " for “" + q + "”", icon: s.icon,
                     path: s.path + "?q=" + encodeURIComponent(q) });
        });
        return out;
      }

      var CMDS = [
        { label: "Dashboard", path: "<%= root_path %>", icon: "<%= RoundhouseUi::Icons.markup(:dashboard) %>" },
        { label: "Metrics", path: "<%= metrics_path %>", icon: "<%= RoundhouseUi::Icons.markup(:metrics) %>" },
        { label: "Busy", path: "<%= busy_path %>", icon: "<%= RoundhouseUi::Icons.markup(:busy) %>" },
        <% if RoundhouseUi.backend.supports?(:workers) %>{ label: "Workers", path: "<%= workers_path %>", icon: "<%= RoundhouseUi::Icons.markup(:workers) %>" },<% end %>
        { label: "Queues", path: "<%= queues_path %>", icon: "<%= RoundhouseUi::Icons.markup(:queues) %>" },
        { label: "Scheduled", path: "<%= scheduled_path %>", icon: "<%= RoundhouseUi::Icons.markup(:scheduled) %>" },
        <% if RoundhouseUi.backend.supports?(:retries) %>{ label: "Retries", path: "<%= retries_path %>", icon: "<%= RoundhouseUi::Icons.markup(:retries) %>" },<% end %>
        { label: "Errors", path: "<%= errors_path %>", icon: "<%= RoundhouseUi::Icons.markup(:errors) %>" },
        { label: "Dead", path: "<%= dead_set_path %>", icon: "<%= RoundhouseUi::Icons.markup(:dead) %>" },
        <% if defined?(Sidekiq::Capsule) && RoundhouseUi.backend.supports?(:capsules) %>{ label: "Capsules", path: "<%= capsules_path %>", icon: "<%= RoundhouseUi::Icons.markup(:capsules) %>" },<% end %>
        <% if RoundhouseUi.backend.supports?(:redis) %>{ label: "Redis", path: "<%= redis_info_path %>", icon: "<%= RoundhouseUi::Icons.markup(:redis) %>" },<% end %>
        { label: "Snapshots", path: "<%= snapshots_path %>", icon: "<%= RoundhouseUi::Icons.markup(:snapshots) %>" },
        { label: "Audit log", path: "<%= audit_log_path %>", icon: "<%= RoundhouseUi::Icons.markup(:audit) %>" },
        { label: "Settings", path: "<%= settings_path %>", icon: "<%= RoundhouseUi::Icons.markup(:settings) %>" },
        <% if RoundhouseUi.allow_job_editing %>{ label: "Enqueue job", path: "<%= new_job_path %>", icon: "<%= RoundhouseUi::Icons.markup(:enqueue) %>" },<% end %>
        { label: "Toggle theme", action: "theme", icon: "<%= RoundhouseUi::Icons.markup(:busy) %>" },
        { label: "Toggle full width", action: "width", icon: "<%= RoundhouseUi::Icons.markup(:width) %>" }
      ];
      var palSel = 0, palFiltered = [];
      function palEl() { return document.getElementById("rh-palette"); }
      function palInputEl() { return document.getElementById("rh-palette-input"); }
      function palListEl() { return document.getElementById("rh-palette-list"); }
      function palMark() {
        var l = palListEl(); if (!l) return;
        var it = l.children;
        for (var i = 0; i < it.length; i++) it[i].className = "rh-palette-item" + (i === palSel ? " sel" : "");
        if (it[palSel]) it[palSel].scrollIntoView({ block: "nearest" });
      }
      function palRender() {
        var input = palInputEl(), list = palListEl(); if (!input || !list) return;
        var q = input.value.trim().toLowerCase();
        var nav = CMDS.filter(function (c) { return c.label.toLowerCase().indexOf(q) !== -1; });
        // Search actions lead once you've typed: with a query, finding the job
        // is the intent; jumping to a page is the fallback.
        palFiltered = q ? palQuery(q).concat(nav) : nav;
        if (palSel >= palFiltered.length) palSel = Math.max(0, palFiltered.length - 1);
        list.innerHTML = "";
        palFiltered.forEach(function (c, i) {
          var d = document.createElement("div");
          d.className = "rh-palette-item" + (i === palSel ? " sel" : "");
          var s = document.createElement("span"); s.className = "rh-palette-ico"; s.textContent = c.icon;
          d.appendChild(s); d.appendChild(document.createTextNode(c.label));
          d.addEventListener("click", function () { palRun(c); });
          d.addEventListener("mousemove", function () { palSel = i; palMark(); });
          list.appendChild(d);
        });
      }
      function palRun(c) {
        palClose();
        if (c.action === "theme") { var b = document.getElementById("rh-theme"); if (b) b.click(); return; }
        if (c.action === "width") { var wb = document.getElementById("rh-width"); if (wb) wb.click(); return; }
        if (c.path) { window.Turbo ? Turbo.visit(c.path) : (location.href = c.path); }
      }
      function palOpen() { var p = palEl(), i = palInputEl(); if (!p || !i) return; p.hidden = false; i.value = ""; palSel = 0; palRender(); i.focus(); }
      function palClose() { var p = palEl(); if (p) p.hidden = true; }

      document.addEventListener("input", function (e) { if (e.target && e.target.id === "rh-palette-input") { palSel = 0; palRender(); } });
      document.addEventListener("click", function (e) {
        if (e.target && e.target.id === "rh-palette") { palClose(); return; }
        if (e.target.closest && e.target.closest("#rh-palette-open")) { e.preventDefault(); palOpen(); }
      });
      // Settings page. Delegated from document so it survives Turbo body swaps,
      // the same reason select-all is (#26). Every control writes local storage
      // and applies immediately — there is no Save button because there is
      // nothing to submit.
      function prefRead(key) { try { return localStorage.getItem(key) || ""; } catch (_) { return ""; } }
      function prefWrite(key, value) {
        try { value === "" ? localStorage.removeItem(key) : localStorage.setItem(key, value); } catch (_) {}
      }
      function syncSettingsForm() {
        var t = document.getElementById("rh-set-theme"); if (t) t.value = prefRead("rh-theme") || "dark";
        var p = document.getElementById("rh-set-palette"); if (p) p.value = prefRead("rh-palette");
        var w = document.getElementById("rh-set-width"); if (w) w.value = prefRead("rh-width") || "compact";
        var i = document.getElementById("rh-set-poll"); if (i) i.value = prefRead("rh-poll");
      }
      function applyAttr(name, value) {
        value ? document.documentElement.setAttribute(name, value)
              : document.documentElement.removeAttribute(name);
      }
      document.addEventListener("change", function (e) {
        var el = e.target; if (!el || !el.id) return;
        if (el.id === "rh-m-deadline" && lastCapacity) {
          var c = capacity(lastCapacity.backlog, lastCapacity.rate, lastCapacity.vel,
                           lastCapacity.concurrency, parseInt(el.value, 10));
          setText("rh-m-capacity", c.text); setText("rh-m-capacity-note", c.note);
        }
        if (el.id === "rh-set-theme")   { prefWrite("rh-theme", el.value);   applyAttr("data-theme", el.value); syncTheme(); }
        if (el.id === "rh-set-palette") { prefWrite("rh-palette", el.value); applyAttr("data-rh-palette", el.value); }
        if (el.id === "rh-set-width")   { prefWrite("rh-width", el.value);   applyAttr("data-width", el.value); syncWidth(); }
        if (el.id === "rh-set-poll")    { prefWrite("rh-poll", el.value);    restartPoll(); }
      });
      document.addEventListener("click", function (e) {
        if (!e.target.closest || !e.target.closest("#rh-set-reset")) return;
        [ "rh-theme", "rh-palette", "rh-width", "rh-poll" ].forEach(function (k) { prefWrite(k, ""); });
        [ "data-theme", "data-rh-palette", "data-width" ].forEach(function (a) { applyAttr(a, null); });
        syncTheme(); syncWidth(); restartPoll(); syncSettingsForm();
      });

      // Throughput interval picker — persist the choice; changing it re-buckets
      // from here on, so reset the in-progress bucket and redraw.
      function restoreChartInterval() {
        var s = document.getElementById("rh-chart-interval"); if (!s) return;
        try { var v = localStorage.getItem("rh-chart-iv"); if (v) s.value = v; } catch (_) {}
      }
      document.addEventListener("change", function (e) {
        if (!e.target || e.target.id !== "rh-chart-interval") return;
        try { localStorage.setItem("rh-chart-iv", e.target.value); } catch (_) {}
        samples = []; bucketStart = null; draw();
      });

      document.addEventListener("keydown", function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) { e.preventDefault(); var p = palEl(); (p && p.hidden) ? palOpen() : palClose(); return; }
        var p = palEl(); if (!p || p.hidden) return;
        if (e.key === "Escape") palClose();
        else if (e.key === "ArrowDown") { e.preventDefault(); palSel = Math.min(palSel + 1, palFiltered.length - 1); palMark(); }
        else if (e.key === "ArrowUp") { e.preventDefault(); palSel = Math.max(palSel - 1, 0); palMark(); }
        else if (e.key === "Enter") { e.preventDefault(); if (palFiltered[palSel]) palRun(palFiltered[palSel]); }
      });

      document.addEventListener("turbo:load", function () { startOnce(); syncTheme(); syncWidth(); syncSettingsForm(); setActiveNav(); restoreChartInterval(); wireChart(); draw(); });

      // Dead set "select all". Delegated from document rather than bound to the
      // checkbox, because a Turbo visit (searching, paging, arriving via the
      // nav) replaces <body> — the old element and its listener are discarded,
      // and a re-inserted body script carries a nonce the original page's CSP
      // does not accept. document survives both, so this binds once and keeps
      // working. See issue #26.
      document.addEventListener("change", function (e) {
        if (!e.target || e.target.id !== "rh-all") return;
        document.querySelectorAll(".rh-check").forEach(function (cb) { cb.checked = e.target.checked; });
      });
      document.addEventListener("DOMContentLoaded", function () { startOnce(); syncTheme(); syncWidth(); setActiveNav(); restoreChartInterval(); wireChart(); });
      document.addEventListener("visibilitychange", function () { if (!document.hidden) poll(); });
    })();
  </script>
</head>
<body class="rh-body">
  <div class="rh-app">
    <aside class="rh-rail" id="rh-rail" data-turbo-permanent>
      <div class="rh-brand"><div class="glyph">⎈</div><div><b>Roundhouse</b><small>sidekiq console</small></div></div>

      <nav class="rh-grp">
        <div class="rh-grp-label">Overview</div>
        <%= nav_link "Dashboard", root_path, icon: :dashboard %>
        <%= nav_link "Metrics", metrics_path, icon: :metrics %>
        <%= nav_link "Busy", busy_path, icon: :busy, badge: "busy", badge_title: "Jobs running right now" %>
        <% if RoundhouseUi.backend.supports?(:workers) %>
          <%= nav_link "Workers", workers_path, icon: :workers %>
        <% end %>
      </nav>
      <nav class="rh-grp">
        <div class="rh-grp-label">Work</div>
        <%= nav_link "Queues", queues_path, icon: :queues, badge: "enqueued", badge_title: "Jobs enqueued across all queues" %>
        <%= nav_link "Scheduled", scheduled_path, icon: :scheduled, badge: "scheduled", badge_title: "Jobs scheduled for later" %>
        <% if RoundhouseUi.backend.supports?(:retries) %>
          <%= nav_link "Retries", retries_path, icon: :retries, badge: "retries", badge_class: "warn", badge_title: "Jobs waiting to retry" %>
        <% end %>
        <%= nav_link "Errors", errors_path, icon: :errors %>
        <%= nav_link "Dead", dead_set_path, icon: :dead, badge: "dead", badge_class: "crit", badge_title: "Jobs that exhausted their retries" %>
        <% if RoundhouseUi.allow_job_editing %>
          <%= nav_link "Enqueue job", new_job_path, icon: :enqueue %>
        <% end %>
      </nav>
      <nav class="rh-grp">
        <div class="rh-grp-label">Infrastructure</div>
        <%# Capsules are a Sidekiq 7+ concept — hide on 6.x and on non-Sidekiq backends. %>
        <% if defined?(Sidekiq::Capsule) && RoundhouseUi.backend.supports?(:capsules) %>
          <%= nav_link "Capsules", capsules_path, icon: :capsules %>
        <% end %>
        <% if RoundhouseUi.backend.supports?(:redis) %>
          <%= nav_link "Redis", redis_info_path, icon: :redis %>
        <% end %>
        <%= nav_link "Snapshots", snapshots_path, icon: :snapshots %>
        <%= nav_link "Audit log", audit_log_path, icon: :audit %>
          <%= nav_link "Settings", settings_path, icon: :settings %>
      </nav>
    </aside>

    <main class="rh-main">
      <header class="rh-top">
        <h1><%= yield :title %></h1>
        <span class="rh-crumb"><%= yield :crumb %></span>
        <span class="rh-spacer"></span>
        <span class="rh-live" id="rh-live" title="Refreshes automatically — change the interval in Settings">
          <span class="rh-tick"><span class="rh-tick-fill" id="rh-tick"></span></span>
          <span id="rh-live-label">live</span> · <span class="num" data-stat="rate">—</span>/min</span>
        <% if RoundhouseUi.read_only %><span class="rh-ro">read-only</span><% end %>
        <button class="rh-kbd" id="rh-palette-open" type="button" title="Command palette (⌘K)">⌘K</button>
        <button class="rh-iconbtn" id="rh-width" type="button" title="Toggle full width" aria-label="Toggle full width">⟷</button>
        <button class="rh-iconbtn" id="rh-theme" type="button" title="Toggle theme" aria-label="Toggle theme">☾</button>
      </header>

      <% if flash[:notice] %><div class="rh-flash rh-flash-ok"><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="rh-flash rh-flash-bad"><%= flash[:alert] %></div><% end %>

      <%= yield %>
    </main>
  </div>

  <div id="rh-palette" class="rh-palette" data-turbo-permanent hidden>
    <div class="rh-palette-box">
      <input id="rh-palette-input" type="text" placeholder="Search a job ID, queue, squad, or class — or jump to a page" autocomplete="off">
      <div id="rh-palette-list" class="rh-palette-list"></div>
    </div>
  </div>
</body>
</html>
